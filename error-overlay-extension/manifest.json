{
  "manifest_version": 3,
  "name": "No-Code Error Overlay",
  "version": "1.0",
  "description": "Provides easy-to-understand fixes for errors in no-code apps.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.bubble.io/*",
        "*://*.adalo.com/*",
        "*://*.glideapps.com/*",
        "*://*.airtable.com/*",
        "*://*.notion.so/*"
      ],
      "js": ["content.js"],
      "css": ["overlay.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "No-Code Error Helper"
  }
}