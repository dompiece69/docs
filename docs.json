{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "dark",
  "name": "Space Rocks",
  "colors": {
    "primary": "#8B5CF6",
    "light": "#A78BFA",
    "dark": "#6D28D9"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Game Guide",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "quickstart",
              "how-to-play"
            ]
          },
          {
            "group": "Game Mechanics",
            "pages": [
              "game/geo-location",
              "game/rock-collection",
              "game/evolution-system",
              "game/rarity-tiers"
            ]
          },
          {
            "group": "NFT & Blockchain",
            "pages": [
              "nft/minting-process",
              "nft/wallet-integration",
              "nft/marketplace",
              "nft/smart-contracts"
            ]
          },
          {
            "group": "Tokenomics",
            "pages": [
              "tokenomics/overview",
              "tokenomics/play-and-earn",
              "tokenomics/meme-coin",
              "tokenomics/rewards"
            ]
          }
        ]
      },
      {
        "tab": "Developer Docs",
        "groups": [
          {
            "group": "Integration",
            "pages": [
              "development",
              "developers/mobile-sdk",
              "developers/web3-integration",
              "developers/geolocation-api"
            ]
          },
          {
            "group": "API Reference",
            "pages": [
              "api-reference/introduction",
              "api-reference/authentication",
              "api-reference/endpoints/rocks",
              "api-reference/endpoints/nfts",
              "api-reference/endpoints/users"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Play Now",
          "href": "https://spacerocks.game",
          "icon": "rocket"
        },
        {
          "anchor": "Community",
          "href": "https://discord.gg/spacerocks",
          "icon": "discord"
        },
        {
          "anchor": "Marketplace",
          "href": "https://marketplace.spacerocks.game",
          "icon": "store"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@spacerocks.game"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Launch App",
      "href": "https://app.spacerocks.game"
    }
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
     "claude",
     "perplexity",
     "mcp",
     "cursor",
     "vscode"
   ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/spacerocksGame",
      "github": "https://github.com/spacerocks",
      "discord": "https://discord.gg/spacerocks"
    }
  }
}
